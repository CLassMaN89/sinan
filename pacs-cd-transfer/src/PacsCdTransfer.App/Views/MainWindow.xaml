<Window x:Class="PacsCdTransfer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PacsCdTransfer.App.Views"
        Title="PACS CD Transfer" Height="760" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT RAIL -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16">
                <TextBlock DockPanel.Dock="Top" Text="MODÜL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextLoBrush}"
                           Margin="4,0,0,10" HorizontalAlignment="Left"/>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavCdTransfer" Style="{StaticResource RailNavButton}" GroupName="Rail" IsChecked="True" Checked="NavCdTransfer_Checked">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="34" Height="34" Fill="{StaticResource AccentBgBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="CD Transfer" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavQuery" Style="{StaticResource RailNavButton}" GroupName="Rail" Checked="NavQuery_Checked">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="34" Height="34" Fill="{StaticResource TealBgBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sorgu / Getir" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineButton}" Click="SettingsButton_Click" HorizontalAlignment="Stretch" Padding="8">
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="{StaticResource SurfaceAltBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ayarlar" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="34" Height="34" Fill="{StaticResource AccentBrush}"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PacsCD Transfer" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="DICOM CD → PACS" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource OkBgBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock Text="● Çevrimiçi" Foreground="{StaticResource OkBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,14,0">
                            <TextBlock x:Name="AetLabel" FontSize="11" Foreground="{StaticResource TextMdBrush}"/>
                        </Border>
                        <TextBlock x:Name="UserLabel" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource TextLoBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="20">
                <local:CdTransferView x:Name="CdTransferTab"/>
                <local:QueryView x:Name="QueryTab" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
