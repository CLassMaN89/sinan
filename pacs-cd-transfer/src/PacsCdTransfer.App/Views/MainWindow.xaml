<Window x:Class="PacsCdTransfer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PACS CD Transfer" Height="760" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <wv2:WebView2 x:Name="Browser"/>
        <TextBlock x:Name="LoadingText" Text="Yükleniyor…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
    </Grid>
</Window>
