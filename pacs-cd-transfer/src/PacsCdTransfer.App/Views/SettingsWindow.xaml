<Window x:Class="PacsCdTransfer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Height="620" Width="820" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="SavedText" Foreground="{StaticResource OkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" Text="Kaydedildi"/>
            <Button Content="Vazgeç" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Dicom Bilgileri">
                <StackPanel Margin="16">
                    <TextBlock Text="Yerel AE Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="LocalAeBox" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="Yerel Port" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="LocalPortBox" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="Geçici Depolama Klasörü" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="StorageFolderBox" Width="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="Aynı Anda Gönderilecek Maksimum Seri" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="MaxBatchBox" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Pacs Bilgileri">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Gönderim Hedefleri" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox x:Name="DestList" Height="120" DisplayMemberPath="."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBox x:Name="NewDestAe" Width="150" Margin="0,0,6,0"/>
                            <TextBox x:Name="NewDestHost" Width="130" Margin="0,0,6,0"/>
                            <TextBox x:Name="NewDestPort" Width="70" Margin="0,0,6,0" Text="104"/>
                            <Button Content="Hedef Ekle" Style="{StaticResource OutlineButton}" Click="AddDest_Click" Margin="0,0,6,0"/>
                            <Button Content="Seçileni Sil" Style="{StaticResource OutlineButton}" Click="RemoveDest_Click"/>
                        </StackPanel>

                        <TextBlock Text="Sorgu Kaynakları" FontWeight="Bold" Margin="0,16,0,8"/>
                        <ListBox x:Name="SrcList" Height="120" DisplayMemberPath="."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBox x:Name="NewSrcAe" Width="150" Margin="0,0,6,0"/>
                            <TextBox x:Name="NewSrcHost" Width="130" Margin="0,0,6,0"/>
                            <TextBox x:Name="NewSrcPort" Width="70" Margin="0,0,6,0" Text="104"/>
                            <ComboBox x:Name="NewSrcMode" Width="90" Margin="0,0,6,0" SelectedIndex="0">
                                <ComboBoxItem Content="C-MOVE"/>
                                <ComboBoxItem Content="C-GET"/>
                            </ComboBox>
                            <Button Content="Kaynak Ekle" Style="{StaticResource OutlineButton}" Click="AddSrc_Click" Margin="0,0,6,0"/>
                            <Button Content="Seçileni Sil" Style="{StaticResource OutlineButton}" Click="RemoveSrc_Click"/>
                        </StackPanel>
                        <Button Content="Bağlantıyı Test Et (seçili hedef)" Style="{StaticResource OutlineButton}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="TestConnection_Click"/>
                        <TextBlock x:Name="TestResultText" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kullanıcılar &amp; Yetkiler">
                <StackPanel Margin="16">
                    <TextBlock Text="Yalnızca yönetici kullanıcı ekleyip çıkarabilir." Foreground="{StaticResource TextLoBrush}" FontSize="11" Margin="0,0,0,10"/>
                    <ListBox x:Name="UserList" Height="160"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="NewUserName" Width="150" Margin="0,0,6,0"/>
                        <PasswordBox x:Name="NewUserPassword" Width="150" Margin="0,0,6,0"/>
                        <CheckBox x:Name="NewUserCanTransfer" Content="CD Transfer" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="NewUserCanQuery" Content="Sorgu/Getir" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Kullanıcı Ekle" Style="{StaticResource OutlineButton}" Click="AddUser_Click" Margin="0,0,6,0"/>
                        <Button Content="Seçileni Sil" Style="{StaticResource OutlineButton}" Click="RemoveUser_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Bağlantı Günlüğü">
                <DockPanel Margin="16">
                    <Button DockPanel.Dock="Top" Content="Günlüğü Temizle" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="ClearLog_Click"/>
                    <ListBox x:Name="LogList"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
