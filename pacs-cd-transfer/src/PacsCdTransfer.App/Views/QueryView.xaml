<UserControl x:Class="PacsCdTransfer.App.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hasta Adı Soyadı" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="PatientNameBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hasta ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="PatientIdBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Accession No" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="AccessionBox"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Kaynak" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SourceCombo" DisplayMemberPath="AeTitle"/>
                </StackPanel>
                <Button Grid.Column="8" Content="Sorgula" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Search_Click"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12"/>

        <ListView x:Name="ResultsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Hasta" Width="220" DisplayMemberBinding="{Binding PatientName}"/>
                    <GridViewColumn Header="Hasta ID" Width="120" DisplayMemberBinding="{Binding PatientId}"/>
                    <GridViewColumn Header="Tarih" Width="100" DisplayMemberBinding="{Binding StudyDate}"/>
                    <GridViewColumn Header="Modalite" Width="90" DisplayMemberBinding="{Binding Modality}"/>
                    <GridViewColumn Header="Kurum" Width="160" DisplayMemberBinding="{Binding InstitutionName}"/>
                    <GridViewColumn Header="" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Getir" Style="{StaticResource OutlineButton}" Click="Retrieve_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
