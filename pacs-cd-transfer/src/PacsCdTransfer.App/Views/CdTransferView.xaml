<UserControl x:Class="PacsCdTransfer.App.Views.CdTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: CD detection + patient list -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CD Sürücüleri" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button DockPanel.Dock="Top" Content="Sürücüleri Tara" Style="{StaticResource OutlineButton}" Click="ScanDrives_Click" Margin="0,0,0,10"/>
                <ListBox x:Name="DriveList" DockPanel.Dock="Top" Height="60" Margin="0,0,0,10"
                         SelectionChanged="DriveList_SelectionChanged"/>
                <Button DockPanel.Dock="Top" Content="CD'yi Oku" Style="{StaticResource PrimaryButton}" Click="ReadDisc_Click" Margin="0,0,0,10" IsEnabled="False" x:Name="ReadDiscButton"/>

                <TextBlock DockPanel.Dock="Top" Text="CD'deki Hastalar" FontWeight="Bold" Margin="0,4,0,8"/>
                <ListBox x:Name="StudyList" SelectionChanged="StudyList_SelectionChanged"
                         DisplayMemberPath="PatientName"/>
            </DockPanel>
        </Border>

        <!-- RIGHT: detail + worklist + send -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CD Detayı" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hasta Adı Soyadı" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="PatientNameBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TC Kimlik No" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TcBox" MaxLength="11"/>
                        <TextBlock x:Name="TcError" Foreground="{StaticResource DangerBrush}" FontSize="10" Visibility="Collapsed" Text="TC Kimlik No 11 haneli olmalıdır." Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Seriler" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <ListBox x:Name="SeriesList" DockPanel.Dock="Top" Height="90" SelectionMode="Multiple" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" IsChecked="True"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Gönderilecek Hedef" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DestCombo" DisplayMemberPath="AeTitle"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="PACS'e Gönder" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Send_Click"/>
                </Grid>

                <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12"/>

                <TextBlock DockPanel.Dock="Top" Text="Gönderim Kuyruğu (Worklist)" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <ListBox x:Name="WorklistBox" DisplayMemberPath="PatientName"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
